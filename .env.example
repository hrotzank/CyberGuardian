# =============================================================================
# CyberGuardian — Plantilla de Variables de Entorno
# =============================================================================
# Copia este archivo como .env en la raíz del proyecto y completa los valores.
#   cp .env.example .env
#
# NUNCA subas tu archivo .env a GitHub. Ya está excluido por .gitignore.
# Este archivo (.env.example) SÍ puede versionarse porque no contiene credenciales.
# =============================================================================


# -----------------------------------------------------------------------------
# API de Groq (requerida para análisis con IA)
# -----------------------------------------------------------------------------
# Obtén tu clave gratuita en: https://console.groq.com/keys
# Sin esta clave, el sistema opera en modo heurístico local (sin IA).
GROQ_API_KEY=tu_clave_groq_aqui

# Modelo de lenguaje a utilizar con Groq.
# Modelos verificados y disponibles (consultados vía GET /openai/v1/models):
#   openai/gpt-oss-120b   — 131k tokens de contexto (recomendado, usado por defecto)
#   openai/gpt-oss-20b    — 131k tokens de contexto (más rápido)
#   qwen/qwen3.8-27b      — 131k tokens de contexto
#   allam-2-7b            — 4k tokens de contexto
# Para ver la lista completa y actualizada:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
AI_MODEL=openai/gpt-oss-120b

# Proveedor de IA. Actualmente solo se usa "groq".
AI_PROVIDER=groq


# -----------------------------------------------------------------------------
# Base de datos (SQLite local por defecto)
# -----------------------------------------------------------------------------
# Para uso local con SQLite (archivo generado automáticamente al iniciar):
DATABASE_URL=sqlite:///./cyberguardian.db

# Para producción con PostgreSQL, usar algo como:
# DATABASE_URL=postgresql://usuario:password@host:5432/cyberguardian


# -----------------------------------------------------------------------------
# Servidor FastAPI (opcional, con valores por defecto)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# CORS — Orígenes permitidos para el frontend
# -----------------------------------------------------------------------------
# Lista de orígenes permitidos separados por coma.
# Desarrollo local (Vite):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Producción (ejemplo):
# ALLOWED_ORIGINS=https://cyberguardian.app,https://www.cyberguardian.app


# -----------------------------------------------------------------------------
# VirusTotal API (opcional para análisis de reputación de URLs y Hashes)
# -----------------------------------------------------------------------------
# Obtén tu clave gratuita en: https://www.virustotal.com/gui/my-apikey
# Si no se configura o falla, el bot activa automáticamente el motor heurístico local.
VIRUSTOTAL_API_KEY=tu_clave_virustotal_aqui


# -----------------------------------------------------------------------------
# Bot de Telegram (opcional)
# -----------------------------------------------------------------------------
# Obtén tu token creando un bot con @BotFather en Telegram.
# Sin este token, el bot de Telegram no podrá iniciarse.
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
